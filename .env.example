# Supabase (server only: never expose the service key in the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=

# Telegram bot token from @BotFather
BOT_TOKEN=
# Chat id of the admin (or a group) that receives new bookings
ADMIN_CHAT_ID=

# Optional: e-mail copy of each booking through Resend
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Garage Detailing <onboarding@resend.dev>

# Optional: public site url, used in bot messages
SITE_URL=
